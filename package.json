{
  "name": "time-machine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "measure": "MEASURE=1 playwright test e2e/measure.spec.ts",
    "asset:generate": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} --background --factory-startup --python assets/blender/merchant_house.py --",
    "asset:export": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} --background --factory-startup --python assets/blender/export_glb.py -- assets/merchant-house/merchant-house.blend src/render/models/merchant-house.glb",
    "asset:generate:ilojo": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} --background --factory-startup --python assets/blender/ilojo_bar.py --",
    "asset:export:ilojo": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} --background --factory-startup --python assets/blender/export_glb.py -- --parts assets/ilojo-bar/ilojo-bar.blend src/render/models/ilojo-bar.glb",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
